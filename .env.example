PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
DATABASE_PATH=./data/app.db
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
STAGE_TIMEOUT_MS=600000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=2000
FAKE_STAGE_DELAY_MS=300
TTS_PROVIDER=edge-tts
EDGE_TTS_PATH=edge-tts
TTS_VOICE_VI=vi-VN-HoaiMyNeural
TTS_VOICE_EN=en-US-AriaNeural
TTS_RATE=+0%
TTS_TIMEOUT_MS=60000
PEXELS_API_KEY=
IMAGE_PROVIDERS=wikimedia,openverse,pexels
# Wikimedia blocks user agents without contact info (HTTP 429). Keep a URL or email here.
IMAGE_SEARCH_USER_AGENT=VideoAgent/0.1 (https://github.com/defu2005/videoGenerator)
IMAGE_DOWNLOAD_MIN_INTERVAL_MS=1000
IMAGE_SEARCH_TIMEOUT_MS=15000
IMAGE_SEARCH_CACHE_TTL_HOURS=168
IMAGE_SEARCH_PER_MINUTE_WIKIMEDIA=60
IMAGE_SEARCH_PER_MINUTE_OPENVERSE=20
IMAGE_SEARCH_PER_MINUTE_PEXELS=180
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Web image search (TASK-007C): Brave Image Search API + optional Gemini grounding.
BRAVE_SEARCH_API_KEY=
WEB_IMAGE_GEMINI_MODEL=gemini-2.5-flash
WEB_IMAGE_SEARCH_PER_MINUTE=30
WEB_IMAGE_DOMAIN_DENYLIST=pinterest.com,pinimg.com,pinterest.co.uk
# Background music: openverse (CC tracks, no key) and/or local (MUSIC_LIBRARY_DIR, default data/music)
MUSIC_PROVIDERS=openverse,local
MUSIC_LIBRARY_DIR=
MUSIC_SEARCH_TIMEOUT_MS=30000
LLM_DEFAULT_PROVIDER=
LLM_DEFAULT_MODEL=
LLM_RESEARCH_PROVIDER=
LLM_RESEARCH_MODEL=
LLM_RESEARCH_MODE=merged
LLM_SCRIPT_PROVIDER=
LLM_SCRIPT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
# Remote Ollama native API (artifacts tunnel). Needs both the HTTPS origin and the bearer token.
REMOTE_OLLAMA_BASE_URL=
REMOTE_OLLAMA_TOKEN=
REMOTE_OLLAMA_MODEL=llama3.2:1b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# OmniRoute local AI gateway (https://github.com/diegosouzapw/OmniRoute). Set the key or URL to enable;
# the URL defaults to http://127.0.0.1:20128/v1.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
# OpenCode Zen (or Go: https://opencode.ai/zen/go/v1). Set the key to enable.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
LLM_TIMEOUT_MS=120000
LLM_CACHE_ENABLED=true
LLM_ENABLE_MOCK=true
LLM_PRICES_JSON=
