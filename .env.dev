# Dev checkout settings (not secret, committed). Loaded only by `npm run dev -w @vg/server`
# before `.env`, so these values win. The product instance never reads this file.
# Dev uses its own sandbox data so dev code, migrations and agents never touch the real DB.
DATA_DIR=./data-dev

AUTH_TRUSTED_ORIGINS=http://localhost:5182,http://127.0.0.1:5182
