{
  "id": "title_card",
  "version": 1,
  "nameVi": "Thẻ tiêu đề",
  "descriptionVi": "Tiêu đề mở đầu, tối đa hai dòng.",
  "kinds": [
    "overlay",
    "fullscreen"
  ],
  "minDurationSec": 2,
